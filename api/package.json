{
  "name": "procovar-pedido-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "reset": "npx prisma migrate reset --force && npx prisma db seed",
    "studio": "npx prisma studio",
    "test": "node --test --import ./tests/registrar.mjs 'tests/*.test.ts'",
    "test:integracion": "node --test --import ./tests/registrar.mjs scripts/pruebas-integracion.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/bull": "^3.15.9",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.13.3",
    "prisma": "^7.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@prisma/internals": "^7.10.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.3.3",
    "tsx": "^4.23.15"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
